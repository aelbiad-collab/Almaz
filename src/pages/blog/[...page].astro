---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Actualités" description="Toutes les actualités et publications du blog de l'Association Horizon Almaz.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Blog</p>
          <h1>Actualités de l'association</h1>
          <p class="lead">Suivez la vie de l'association et les nouvelles du quartier.</p>
        </div>
        <a href={`${base}/blog/publier`} class="btn btn--primary btn--sm">Publier une actualité</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      {page.data.length === 0 ? (
        <p>Aucun article publié pour le moment.</p>
      ) : (
        <div class="grid grid--3">
          {page.data.map((post) => (
            <a class="card news-card" href={`${base}/blog/${post.id}`}>
              <span class="eyebrow">{post.data.date.toLocaleDateString('fr-FR')}</span>
              <h2 style="font-size:1.1rem;">{post.data.title}</h2>
              <p style="color:var(--color-ink-light); font-size:0.9rem;">{post.data.excerpt}</p>
              <div>
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </a>
          ))}
        </div>
      )}

      {page.lastPage > 1 && (
        <nav class="pagination" aria-label="Pagination des actualités">
          {page.url.prev ? (
            <a href={page.url.prev} class="btn btn--outline btn--sm">← Précédent</a>
          ) : (
            <span class="btn btn--outline btn--sm is-disabled" aria-disabled="true">← Précédent</span>
          )}
          <span class="pagination__status">Page {page.currentPage} / {page.lastPage}</span>
          {page.url.next ? (
            <a href={page.url.next} class="btn btn--outline btn--sm">Suivant →</a>
          ) : (
            <span class="btn btn--outline btn--sm is-disabled" aria-disabled="true">Suivant →</span>
          )}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .news-card { display: block; color: inherit; }
  .news-card:hover { text-decoration: none; box-shadow: 0 6px 18px rgba(52,52,44,0.12); }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .pagination__status { font-size: 0.85rem; color: var(--color-ink-light); }
  .btn.is-disabled { opacity: 0.4; pointer-events: none; }
</style>
