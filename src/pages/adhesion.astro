---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Devenir adhérent" description="Formulaire d'inscription pour devenir adhérent de l'Association Horizon Almaz.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Rejoignez-nous</p>
      <h1>Devenir adhérent</h1>
      <p class="lead">Remplissez ce formulaire pour rejoindre l'Association Horizon Almaz pour le Développement.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <form class="card adhesion-form" method="post" action="mailto:contact@horizonalmaz.ma">
        <div class="grid grid--2">
          <label>
            Nom complet
            <input type="text" name="name" required />
          </label>
          <label>
            Téléphone
            <input type="tel" name="phone" required />
          </label>
          <label>
            Email
            <input type="email" name="email" required />
          </label>
          <label>
            Adresse dans le quartier
            <input type="text" name="address" required />
          </label>
        </div>
        <label>
          Motivation / remarques
          <textarea name="message" rows="4"></textarea>
        </label>
        <button type="submit" class="btn btn--primary">Envoyer ma demande</button>
        <p class="help">
          L'enregistrement automatique des demandes d'adhésion dans une base de données
          nécessite l'intégration d'un backend — prévue en phase 2.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .adhesion-form { display: grid; gap: 1rem; }
  .adhesion-form label { display: grid; gap: 0.35rem; font-size: 0.9rem; font-weight: 600; color: var(--color-bark); }
  .adhesion-form input, .adhesion-form textarea {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    background: var(--color-cream);
  }
  .adhesion-form button { justify-self: start; }
  .help { font-size: 0.8rem; color: var(--color-ink-light); margin: 0; }
</style>
